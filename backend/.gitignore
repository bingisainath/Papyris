# backend/.gitignore - ADD THESE LINES

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Database
*.db
*.sqlite3

# Logs
*.log

# Uploaded media (local storage)
uploads/

# Firebase service account: a server secret, never commit it
*firebase*adminsdk*.json
firebase-service-account*.json
