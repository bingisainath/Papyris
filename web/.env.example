# Copy to .env and adjust. All values are optional; these are the defaults.

# Backend base URL (REST API and uploaded media are served from here)
REACT_APP_API_BASE_URL=http://localhost:8000

# WebSocket URL (defaults to the API base URL with ws:// and /api/v1/ws/chat)
# REACT_APP_WS_URL=ws://localhost:8000/api/v1/ws/chat

# localStorage key for the access token
# REACT_APP_TOKEN_STORAGE_KEY=papyris_access_token
